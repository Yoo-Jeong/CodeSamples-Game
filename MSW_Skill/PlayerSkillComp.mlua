-- 이 파일은 팀 프로젝트(Tree of Sharenian) 코드입니다.

@Component
script PlayerSkillComp extends Component

	@TargetUserSync
	@HideFromInspector
	property SyncTable<integer, integer> skillLevels

	@TargetUserSync
	@HideFromInspector
	property SyncTable<integer, number> cooldowns

	@TargetUserSync
	@HideFromInspector
	property integer skillPoint = 0

	@Description("[디버그] 켜면 미소유 스킬도 전부 레벨1로 소유 취급")
	property boolean DebugAllSkills = false

	@ExecSpace("ServerOnly")
	method table ExportSkillData()
		--@ brief : 현재 스킬 데이터 저장(스킬 레벨 + 스킬포인트)

		local skillLevelList = {}
		for skillCode, level in pairs(self.skillLevels) do
			table.insert(skillLevelList, { c = skillCode, lv = level })
		end

		local data = {}
		data.sl = skillLevelList
		data.sp = self.skillPoint
		return data
	end

	@ExecSpace("ServerOnly")
	method void ImportSkillData(table data)
		--@ brief : 저장된 스킬 데이터 복원(기존 캐릭터, DataStorage Decode 테이블)

		-- skillLevels 채우기
		for skillCode, _ in pairs(self.skillLevels) do
			self.skillLevels[skillCode] = nil
		end

		local skillLevelList = data.sl or {}
		for _, entry in ipairs(skillLevelList) do
			local skillCode = tonumber(entry.c)
			local level = tonumber(entry.lv)
			if skillCode ~= nil and level ~= nil then
				self.skillLevels[skillCode] = level
			end
		end

		-- 쿨타임 초기화
		for skillCode, _ in pairs(self.cooldowns) do
			self.cooldowns[skillCode] = nil
		end

		self.skillPoint = tonumber(data.sp) or 0

		self:RefreshStaticPassives()
	end

	@ExecSpace("ServerOnly")
	method void CreateNewData(SCharacterData data)
		--@ brief : [2단계] 신규 캐릭터 스킬 기본 데이터 셋업(신규 캐릭터 전용)
		-- 빈 상태로 초기화만 한다.
		for skillCode, _ in pairs(self.skillLevels) do
			self.skillLevels[skillCode] = nil
		end
		for skillCode, _ in pairs(self.cooldowns) do
			self.cooldowns[skillCode] = nil
		end
		self.skillPoint = 0

		self:RefreshStaticPassives()


		-- 라이브 환경이면 즉시 리턴
		if not Environment:IsMakerPlay() then
			-- 디버그용 스킬 추가
		--[[	self:DebugSetSkillLevel(1281,7) -- 세계수 귀환
			self:DebugSetSkillLevel(5001005,7) -- 대쉬
			self:DebugSetSkillLevel(1001004,20) -- 파워스트라이크
			self:DebugSetSkillLevel(1001005,20) -- 슬래시 블러스트
			self:DebugSetSkillLevel(5100013,1) -- 인듀어런스]]

			self:AddSkillPoint(100) -- 테스트 스킬포인트 지급
			return end
	end

	method boolean HasSkill(integer skillCode)
		-- 이 스킬을 소유했는지: 레벨이 1 이상이거나 AlwaysOwned면 소유
		-- 디버그용: DebugAllSkills=true면 모든스킬 1레벨 상태로 소유
		if self.DebugAllSkills then
			return true
		end

		if self.skillLevels[skillCode] ~= nil then
			return true
		end

		local catalogData = _SkillData:GetCatalogData(skillCode)
		return catalogData ~= nil and catalogData.AlwaysOwned == true
	end

	method boolean HasPickaxeEquipped()
		-- 곡괭이 칸에 뭐라도 끼고 있는지

		---@type PlayerInventoryComp
		local inventoryComp = self.Entity.PlayerInventoryComp
		if not isvalid(inventoryComp) then
			return false
		end
		return inventoryComp.equipTable[_EEquipSlot.PICKAXE] ~= nil
	end

	method boolean HasRequiredWeapon(integer skillCode)
		-- 이 스킬을 쓰려면 끼고 있어야 하는 무기가 있는지 본다.
		-- 카탈로그 AllowedWeapons가 빈칸이면 무기를 안 가리는 스킬이라 항상 참(기본공격, 대쉬, 귀환 등)
		local catalogData = _SkillData:GetCatalogData(skillCode)
		if catalogData == nil or catalogData.AllowedWeapons == nil then
			return true
		end

		-- 곡괭이는 무기 칸이 아니라 곡괭이 칸에 들어간다. 칸이 찼는지로 본다.
		if catalogData.AllowedWeapons["PICKAXE"] == true and self:HasPickaxeEquipped() then
			return true
		end

		-- 무기 칸: 들고 있는 무기 종류가 허용 목록에 있으면 통과. 맨손이면 0이라 여기서 걸린다.
		local equipped = _PlayerMotionData:GetEquippedWeaponSubType(self.Entity)
		if equipped == 0 then
			return false
		end
		for weaponName, _ in pairs(catalogData.AllowedWeapons) do
			-- 곡괭이는 위에서 이미 봤으니 건너뛴다.
			if weaponName ~= "PICKAXE" and _EEquipSubCategory:ToValue(weaponName) == equipped then
				return true
			end
		end
		return false
	end

	method boolean CanUse(integer skillCode)
		-- "이 스킬 쓸 수 있는지" 판단(소유 + 쿨타임 + MP)
		-- TryUseSkill()와 시전 확정 RequestApplySkillCost()이 쓴다.
		if not self:CanUseIgnoringMp(skillCode) then
			return false
		end

		-- MP 검사
		if not self:HasEnoughMp(skillCode) then
			return false
		end

		return true
	end

	method boolean CanUseIgnoringMp(integer skillCode)
		-- 소유와 쿨타임만 본다. MP는 제외하고 판단한다.

		-- 소유 검사: 미소유(레벨 없음, AlwaysOwned 아님)면 못 쓴다.
		if not self:HasSkill(skillCode) then
			return false
		end

		-- 무기 검사: 그 스킬이 요구하는 무기를 안 끼고 있으면 못 쓴다(곡괭이 없이 채광 등)
		if not self:HasRequiredWeapon(skillCode) then
			return false
		end

		-- 쿨타임 검사
		-- 시각 비교는 ServerElapsedSeconds로 한다. ElapsedSeconds는 서버=월드생성후/클라=접속후라 시작점이 달라 어긋난다.
		local readyAt = self.cooldowns[skillCode]
		if readyAt ~= nil and _UtilLogic.ServerElapsedSeconds < readyAt then
			-- ===== [디버그 로그] 쿨타임 남은 시간 출력 =====
			local remaining = readyAt - _UtilLogic.ServerElapsedSeconds
			local catalogData = _SkillData:GetCatalogData(skillCode)
			local skillName = "?"
			if catalogData ~= nil and catalogData.DisplayName ~= nil then
				skillName = catalogData.DisplayName
			end
			_LogManager:Log(string.format("[PlayerSkillComp] 쿨타임 중: %s(code=%d) %.1f초 남았습니다.", skillName, skillCode, remaining))
			-- ===== [디버그 로그 끝] =====

			return false
		end

		return true
	end

	method integer GetMpCost(integer skillCode)
		-- 이 스킬을 지금 레벨로 쓸 때 드는 MP. 안 드는 스킬이면 0
		-- 레벨마다 다르다(파워스트라이크 1레벨 4 -> 20레벨 10)

		local levelData = _SkillData:GetLevelData(skillCode, self:GetSkillLevel(skillCode))
		if levelData == nil or levelData.MpCost == nil then
			return 0
		end
		return levelData.MpCost
	end

	method boolean HasEnoughMp(integer skillCode)
		-- MP가 모자라지 않은지. MP소비 없는 스킬은 항상 true
		local cost = self:GetMpCost(skillCode)
		if cost <= 0 then
			return true
		end

		local status = self.Entity.PlayerStatusComp
		if not isvalid(status) then
			return false
		end
		return status:GetCurrentMp() >= cost
	end

	method integer GetSkillLevel(integer skillCode)
		-- 플레이어의 현재 스킬 레벨
		local level = self.skillLevels[skillCode]
		if level ~= nil then
			return level
		end

		-- 레벨 없는 스킬: 항상보유(MaxLevel 0) 스킬은 0레벨이 정상 레벨
		local catalogData = _SkillData:GetCatalogData(skillCode)
		if catalogData ~= nil and catalogData.AlwaysOwned == true then
			return 0
		end

		-- DebugAllSkills면 레벨 없는 스킬도 1레벨로 취급(디버그용)
		if self.DebugAllSkills then
			return 1
		end
		return 0
	end

	method number GetCooldownSeconds(integer skillCode)
		-- 이 스킬을 지금 레벨로 썼을 때 걸리는 총 쿨(초) 쿨 없으면 0
		-- 실제 쿨 시작(HandleSkillUsedEvent)과 UI 표시(액션바 슬롯)가 같은 값을 쓰도록 한 곳에 둔다.

		local levelData = _SkillData:GetLevelData(skillCode, self:GetSkillLevel(skillCode))
		if levelData == nil or levelData.Cooldown == nil then
			return 0
		end
		return levelData.Cooldown
	end

	method boolean IsRequestOwner(string fromUserId)
		-- 서버로 온 요청이 이 캐릭터 주인이 보낸게 맞는지 확인한다
		-- 호출부에서 senderUserId를 넘겨준다. 서버가 붙이는 값.

		local playerComp = self.Entity.PlayerComponent
		if not isvalid(playerComp) then
			return false
		end
		return fromUserId == playerComp.UserId
	end

	@ExecSpace("ServerOnly")
	method void BeginCooldown(integer skillCode)
		-- 쿨타임 길이는 서버가 스킬 레벨을 보고 직접 계산한다.

		local seconds = self:GetCooldownSeconds(skillCode)
		if seconds <= 0 then
			return
		end

		-- ServerElapsedSeconds로 끝나는 시각을 적는다. 판정/UI도 같은 시계로 비교해 서로 어긋나지 않게
		local now = _UtilLogic.ServerElapsedSeconds
		self.cooldowns[skillCode] = now + seconds
		log(string.format("[PlayerSkillComp][Server] BeginCooldown code=%d now=%.2f +%.2fs -> until=%.2f",
			 skillCode, now, seconds, self.cooldowns[skillCode]))
	end

	@ExecSpace("ServerOnly")
	method void PayMpCost(integer skillCode)
		-- 스킬이 실제로 나갔을 때 MP를 깎는다. 차감은 서버만 한다.
		local cost = self:GetMpCost(skillCode)
		if cost <= 0 then
			return
		end

		local status = self.Entity.PlayerStatusComp
		if not isvalid(status) then
			return
		end
		-- SetCurrentMp가 0 밑으로 안 내려가게 막아준다. 모자란지는 CanUse가 미리 걸렀다.
		status:SetCurrentMp(status:GetCurrentMp() - cost)
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillCost(integer skillCode)
		-- 쿨을 걸고 MP를 깎는다. 둘을 따로 부르면 나중에 한쪽만 빠뜨리기 쉬워서 묶어둔다.
		self:BeginCooldown(skillCode)
		self:PayMpCost(skillCode)
	end

	@ExecSpace("ServerOnly")
	method void MarkMpPaid(integer skillCode)
		-- 시전할 때 MP를 냈다는 표시를 남긴다.
		-- 공격 스킬은 시전과 타격 시점이 떨어져 있어서, 타격 때 또 깎지 않도록 이 표시를 본다.
		if self._T.mpPaid == nil then
			self._T.mpPaid = {}
		end
		self._T.mpPaid[skillCode] = true
	end

	@ExecSpace("ServerOnly")
	method boolean ConsumeMpPaidMark(integer skillCode)
		-- 표시가 있으면 지우고 참을 준다(= 시전 때 이미 냈다).
		-- 없으면 거짓. 클라가 시전 알림을 건너뛰고 타격만 요청한 경우라 타격 쪽에서 받아내야 한다.
		if self._T.mpPaid == nil or self._T.mpPaid[skillCode] ~= true then
			return false
		end
		self._T.mpPaid[skillCode] = nil
		return true
	end

	@ExecSpace("Server")
	method void RequestApplySkillCost(integer skillCode)
		-- 스킬을 실제로 시전했다는 클라 알림. 여기서 비용을 확정한다.

		if not self:IsRequestOwner(senderUserId) then
			return
		end

		local catalog = _SkillData:GetCatalogData(skillCode)
		if catalog == nil then
			return
		end

		if not self:CanUse(skillCode) then
			return
		end

		-- 공격 스킬은 쿨을 여기서 걸면 안 된다. 타격 시점 판정에 걸려 데미지가 안 나간다.
		-- 그래서 MP만 시전 즉시 내고 표시를 남긴다. 쿨은 타격 때 CombatManager가 건다.
		if _EPlayerStateType:ToValue(catalog.ActionState) == _EPlayerStateType.ATTACK then
			self:PayMpCost(skillCode)
			self:MarkMpPaid(skillCode)
			return
		end

		-- 그 외 스킬(대쉬, 세계수 귀환 등)은 시전이 곧 발동이라 여기서 쿨과 MP를 함께 처리한다.
		self:ApplySkillCost(skillCode)
	end

	@ExecSpace("ServerOnly")
	method void AddSkillPoint(integer skillpoint)
		-- 스킬포인트를 지급한다.
		if skillpoint == nil or skillpoint <= 0 then
			return
		end
		self.skillPoint = self.skillPoint + skillpoint
	end

	method boolean CanLevelUp(integer skillCode)
		-- 스킬포인트 1을 투자해 레벨을 올릴 수 있는지 판단(첫 습득 0->1 포함)
		-- TODO: 직업,구역,무기 조건

		local catalogData = _SkillData:GetCatalogData(skillCode)
		if catalogData == nil then
			return false
		end
		if self.skillPoint < 1 then
			return false
		end
		return self:GetSkillLevel(skillCode) < catalogData.MaxLevel
	end

	@ExecSpace("ServerOnly")
	method void LevelUpSkill(integer skillCode)
		-- 스킬포인트 1을 투자해 스킬 레벨을 1 올린다(첫 습득 0->1도 같은 1포인트 투자)
		-- 못 올리는 상황이면 아무것도 하지 않는다.

		if not self:CanLevelUp(skillCode) then
			return
		end

		self.skillPoint = self.skillPoint - 1
		local cur = self.skillLevels[skillCode] or 0
		self.skillLevels[skillCode] = cur + 1
		self:RefreshStaticPassives()

		-- (팀원이 작성한 퀘스트 시스템 연동 코드 생략)

		_LogManager:Log("[PlayerSkillComp] ".._SkillData:GetCatalogData(skillCode).DisplayName.."("..skillCode..")".." 스킬 레벨업!")
	end

	@ExecSpace("ServerOnly")
	method void ResetSkills()
		-- 배운 스킬을 모두 초기화하고 투자한 스킬포인트를 돌려준다(레벨업당 1포인트였으므로 레벨 합 = 환원량)
		-- 비용(메소) 처리는 호출부(WorldTreeManager:RequestResetSkills)에서 먼저 한다.
		local refund = 0
		for skillCode, level in pairs(self.skillLevels) do
			refund = refund + level
		end
		for skillCode, _ in pairs(self.skillLevels) do
			self.skillLevels[skillCode] = nil
		end
		self.skillPoint = self.skillPoint + refund
		self:RefreshStaticPassives()

		-- 쿨타임도 같이 비운다. 안 비우면 초기화 전에 쓴 스킬의 쿨이 그대로 남아,
		-- 그 스킬을 다시 배워도 남은 시간 동안 아무 반응 없이 안 나간다.
		for skillCode, _ in pairs(self.cooldowns) do
			self.cooldowns[skillCode] = nil
		end

		-- 스킬이 빠졌으니 이미 도는 Tick 패시브 회복 타이머도 멈춘다
		self:StopUnownedTickPassives()
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 스킬 레벨/포인트가 클라에 동기화되면 UI에 알린다.
		if name == "skillPoint" or name == "skillLevels" then
			local evt = SkillLevelChangedEvt()
			evt.SkillCode = 0
			self.Entity:SendEvent(evt)
		end
	end

	@ExecSpace("ServerOnly")
	method void StopUnownedTickPassives()
		-- 현재 도는 Tick 패시브 중 더 이상 소유하지 않는 것의 타이머를 정리한다(초기화 후 회복 지속 방지)
		-- 타이머가 서버에 있으니 정리도 서버가 한다
		if self._T.tickPassive == nil or self._T.passiveTimers == nil then
			return
		end
		for code, timers in pairs(self._T.passiveTimers) do
			if not self:HasSkill(code) then
				self._T.tickPassive:OnStateExit(self.Entity, code, {}, timers)
				self._T.passiveTimers[code] = nil
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshStaticPassives()
		-- 소유한 Static 패시브들의 스탯 보너스를 다시 등록한다(레벨업/로드 후 호출)
		-- Apply는 같은 출처를 다시 등록할 때 이전 몫을 먼저 빼고 더하므로 여러 번 불러도 중복 안 쌓임
		-- 소유 규칙: DebugAllSkills면 전부 소유, 아니면 레벨이 1 이상이거나 AlwaysOwned면 소유

		local statics = _SkillData:GetPassivesByKind("Static")
		if statics == nil then
			return
		end
		if self._T.staticPassive == nil then
			self._T.staticPassive = SkillPassive()   -- Static 공통 로직(무상태) 하나 재사용
		end
		for _, catalogData in ipairs(statics) do
			local skillCode = catalogData.SkillCode
			local owned = self:HasSkill(skillCode)
			if owned then
				-- Apply/Remove가 스탯에 그때그때 바로 반영하므로, 여기서 따로 재계산할 필요는 없다.
				self._T.staticPassive:Apply(self.Entity, skillCode, self:GetSkillLevel(skillCode))
			else
				self._T.staticPassive:Remove(self.Entity, skillCode)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 컴포넌트 종료(플레이 중지/플레이어 제거) 시, 아직 도는 Tick 패시브 타이머를 모두 정리한다.
		-- 상태 이탈 신호(Entered=false) 없이 종료되면 OnStateExit가 안 불려 타이머가 남는다.
		if self._T.tickPassive == nil or self._T.passiveTimers == nil then
			return
		end

		for code, timers in pairs(self._T.passiveTimers) do
			-- OnStateExit는 params를 쓰지 않으므로 빈 테이블을 넘긴다(타이머 정리 + 루프 이펙트 종료만 수행).
			self._T.tickPassive:OnStateExit(self.Entity, code, {}, timers)
		end
		self._T.passiveTimers = nil
	end

	@ExecSpace("ServerOnly")
	method void DebugSetSkillLevel(integer skillCode, integer level)
		-- 라이브 환경이면 즉시 리턴하여 로그 차단
		if not Environment:IsMakerPlay() then return end

		-- [디버그] 저장/로드 확인용: 스킬을 지정 레벨로 바로 세팅한다.
		local catalogData = _SkillData:GetCatalogData(skillCode)
		if catalogData == nil then
			log(string.format("[PlayerSkillComp] DebugSetSkillLevel: unknown skillCode=%d", skillCode))
			return
		end

		-- 범위를 벗어난 레벨이 오면 MaxLevel or 1
		if level > catalogData.MaxLevel then
			level = catalogData.MaxLevel
		elseif level < 1 then
			level = 1
		end

		self.skillLevels[skillCode] = level
		self:RefreshStaticPassives()
	end

	@ExecSpace("Server")
	method void RequestTickPassiveState(string stateName, boolean entered)
		-- 클라가 알려준 상태 변화를 받아 Tick 패시브를 켜거나 끈다
		if not self:IsRequestOwner(senderUserId) then
			return
		end
		self:UpdateTickPassives(stateName, entered)
	end

	@ExecSpace("ServerOnly")
	method void UpdateTickPassives(string stateName, boolean entered)
		-- TriggerState가 이 상태인 Tick형 패시브를 켜거나 끈다.
		-- Tick형 = 어떤 상태에 있는 동안 일정 간격으로 효과가 도는 패시브(인듀어런스=Idle 동안 회복)
		-- 소유 규칙: DebugAllSkills면 전부 소유, 아니면 레벨이 1 이상이거나 AlwaysOwned면 소유

		local passives = _SkillData:GetPassivesByKind("Tick")
		if passives == nil then
			return
		end
		if self._T.tickPassive == nil then
			self._T.tickPassive = SkillPassive_Tick()   -- Tick 공용 로직 하나 재사용
		end
		if self._T.passiveTimers == nil then
			self._T.passiveTimers = {}
		end

		for _, catalogData in ipairs(passives) do
			-- 이 패시브의 발동 상태(TriggerState)가 알려온 상태와 같을 때만 반응
			if catalogData.TriggerState == stateName then
				local code = catalogData.SkillCode
				if self:HasSkill(code) then
					local params = _SkillData:MakePassiveParams(code, self:GetSkillLevel(code))
					if params ~= nil then
						local timers = self._T.passiveTimers[code]
						if timers == nil then
							timers = {}
							self._T.passiveTimers[code] = timers
						end
						if entered then
							self._T.tickPassive:OnStateEnter(self.Entity, code, params, timers)
						else
							self._T.tickPassive:OnStateExit(self.Entity, code, params, timers)
						end
					end
				end
			end
		end
	end

	@ExecSpace("Client")
	method void NotifyPassiveEffect(integer skillCode, string effectRUID, boolean on)
		-- 서버가 Tick 패시브를 켜고 끌 때 부른다. 루프 이펙트를 그리는 건 클라 몫이라 여기서 처리한다
		local key = "tickpassive:" .. tostring(self.Entity.Name) .. ":" .. tostring(skillCode)
		if on then
			if effectRUID == nil or effectRUID == "" then
				return
			end
			_EffectManager:StartLoop(key, effectRUID, self.Entity, false)
		else
			_EffectManager:StopLoop(key)
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleSkillUsedEvent(PlayerSkillUsedEvent event)
		-- 스킬을 썼다는 이벤트를 받아 서버에 비용(쿨타임/MP)을 물려달라고 요청한다.
		-- 쿨 길이와 MP는 서버가 정한다. 클라는 무슨 스킬을 썼는지만 알린다.

		self:RequestApplySkillCost(event.SkillCode)
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleStateChangeEvent(PlayerStateChangeEvent event)
		-- 상태 진입/이탈을 서버에 알린다. Tick 패시브의 타이머와 회복은 서버가 돌린다.
		-- 상태머신이 클라에서만 돌아서 서버는 상태 변화를 직접 알 수 없다. 클라가 알려준다
		-- event.StateName = 들어오거나 나간 상태(Idle 등), event.Entered = 들어옴(true)/나감(false)

		self:RequestTickPassiveState(event.StateName, event.Entered)
	end

end
